meta {
  name: Get Device Mode Setting List
  type: http
  seq: 1
}

post {
  url: http://www.acinfinityserver.com/api/dev/getdevModeSettingList?port=4&devId={{AI_DEVICE_ID}}
  body: formUrlEncoded
  auth: inherit
}

params:query {
  port: 4
  devId: {{AI_DEVICE_ID}}
}

headers {
  minversion: 3.5
}

body:form-urlencoded {
  userId: {{USER_ID}}
}

settings {
  encodeUrl: true
  timeout: 0
}
